# Copy to .env.local and fill in. Never commit .env.local.
# See docs/spec/08-deploy.md for what each one is for.
# For the hosted project, make a second copy called .env.hosted.local (also never committed).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

RESEND_API_KEY=
# Until midasmedia.co.bw is verified in Resend, use: Midas Media <onboarding@resend.dev>
EMAIL_FROM="Midas Media <noreply@midasmedia.co.bw>"
# Local development only: write emails to this folder instead of sending them.
EMAIL_OUTBOX_DIR=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CRON_SECRET=

# Only for scripts/seed-sample.ts on the hosted project (sample accounts' password).
SEED_PASSWORD=

# Phase 6
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=
GA4_SERVICE_ACCOUNT_JSON=
